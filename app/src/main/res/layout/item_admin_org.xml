<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/OrgName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Org name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/OrgStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="10sp"
            android:textColor="@color/coral_800"
            android:background="@drawable/bg_chip_unselected"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/OrgTypeSubmitted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NGO · Submitted recently"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="10dp" />

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TableRow>
            <TextView android:text="PAN" android:textSize="12sp" android:textColor="@color/text_secondary" android:paddingVertical="2dp" />
            <TextView android:id="@+id/OrgPan" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:paddingVertical="2dp" android:gravity="end" android:layout_width="match_parent" />
        </TableRow>

        <TableRow>
            <TextView android:text="Darpan ID" android:textSize="12sp" android:textColor="@color/text_secondary" android:paddingVertical="2dp" />
            <TextView android:id="@+id/OrgDarpan" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:paddingVertical="2dp" android:gravity="end" android:layout_width="match_parent" />
        </TableRow>

        <TableRow>
            <TextView android:text="Contact" android:textSize="12sp" android:textColor="@color/text_secondary" android:paddingVertical="2dp" />
            <TextView android:id="@+id/OrgContact" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:paddingVertical="2dp" android:gravity="end" android:layout_width="match_parent" />
        </TableRow>

    </TableLayout>

    <TextView
        android:id="@+id/ViewCertificate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📎 View registration certificate"
        android:textSize="12sp"
        android:textColor="@color/coral_600"
        android:background="@drawable/bg_input_field"
        android:padding="10dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprove"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Approve"
            android:textSize="13sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/teal_600" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReject"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Reject"
            android:textSize="13sp"
            android:textColor="@color/coral_800"
            app:backgroundTint="@color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvRejectionReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View full details  ›"
        android:textSize="12sp"
        android:textColor="@color/coral_800"
        android:gravity="center"
        android:layout_marginTop="12dp" />

</LinearLayout>