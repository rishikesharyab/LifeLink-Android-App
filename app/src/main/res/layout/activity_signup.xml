<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EEE3">

    <!-- ================= HERO ================= -->
    <View
        android:id="@+id/heroPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.3" />

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_blood_drop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="52dp" />

    <TextView
        android:id="@+id/signupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Join LifeLink"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:textSize="28sp"
        android:textColor="#FBEFE6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="86dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ONE ACCOUNT · EVERY DROP MATTERS"
        android:fontFamily="sans-serif-medium"
        android:textSize="10sp"
        android:letterSpacing="0.14"
        android:textColor="#F0CBB8"
        app:layout_constraintTop_toBottomOf="@id/signupTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp" />

    <!-- ================= FORM CARD ================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/formCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_top_rounded"
        android:layout_marginTop="-24dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/heroPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_box"
                android:addStatesFromChildren="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_person_outline" />

                <EditText
                    android:id="@+id/nameEt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Full Name"
                    android:textColorHint="#B3A192"
                    android:textColor="#2B1B14"
                    android:textSize="15sp"
                    android:background="@android:color/transparent"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp" />

            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_box"
                android:addStatesFromChildren="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_mail_outline" />

                <EditText
                    android:id="@+id/emailEt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Email"
                    android:textColorHint="#B3A192"
                    android:textColor="#2B1B14"
                    android:textSize="15sp"
                    android:inputType="textEmailAddress"
                    android:background="@android:color/transparent"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp" />

            </LinearLayout>

            <!-- Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_box"
                android:addStatesFromChildren="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_lock_outline" />

                <EditText
                    android:id="@+id/passwordEt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Password"
                    android:textColorHint="#B3A192"
                    android:textColor="#2B1B14"
                    android:textSize="15sp"
                    android:inputType="textPassword"
                    android:background="@android:color/transparent"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp" />

            </LinearLayout>

            <Button
                android:id="@+id/signupBtn"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="34dp"
                android:text="Sign Up"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FBEFE6"
                android:background="@drawable/selector_btn_coral"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/loginText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="Already have an account? Log In"
                android:textColor="#8B3A1F"
                android:textStyle="bold"
                android:textSize="13sp"
                android:padding="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_pulse_line"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@id/formCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>