<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">



    <!-- 🗺️ MAP -->
    <fragment
        android:id="@+id/patientMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 🔍 SEARCH BAR + BLOOD GROUP FILTER (Google Maps style floating) -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_search_container"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="6dp"
        android:clickable="true"
        android:focusableInTouchMode="false">

        <!-- Search Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBackSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/coral_800"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivSearchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/coral_800" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search hospital, area or blood group"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/ivClearSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Blood Group Chip Row (collapsed until search is focused) -->
        <HorizontalScrollView
            android:id="@+id/bloodGroupScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupBloodGroups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"/>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- 🔴 LOGOUT BUTTON -->


    <!-- ⬆️ BOTTOM SHEET -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:paddingBottom="70dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        app:behavior_hideable="true"
        app:behavior_peekHeight="250dp"
        app:behavior_draggable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        >

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_drag_handle"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nearby Blood Donors"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_margin="16dp"/>

        <!-- RecyclerView (Donor List) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/donorRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:layout_marginBottom="90dp"
            android:layout_weight="1"
            android:padding="8dp"/>

        <!-- Empty state — shown when no donors match the selected filter -->
        <TextView
            android:id="@+id/tvNoDonors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No donor found"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="90dp"
            android:background="@drawable/bg_stat_card"
            android:visibility="gone"/>





    </LinearLayout>
    <LinearLayout
        android:id="@+id/customBottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav_rounded"
        android:elevation="10dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"/>

        <LinearLayout
            android:id="@+id/navDonate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"/>

    </LinearLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>